rules_version = '2';

// DATA-002a: nothing is open yet. Every read and write is denied until the
// sign-in work (DATA-002b to d) adds rules that let each signed-in person
// reach only their own answers.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
